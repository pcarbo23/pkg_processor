# ==============================================================================
# Google Antigravity 2.0 / Python Project .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Virtual Environments
# ------------------------------------------------------------------------------
# Exclude standard Python virtual environments used for local dependency isolation
.venv/
venv/
env/
ENV/
pyvenv.cfg
.python-version

# ------------------------------------------------------------------------------
# 2. IDE and Editor Configurations
# ------------------------------------------------------------------------------
# PyCharm / IntelliJ IDEA
.idea/

# Visual Studio Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/settings.json

# Other editors (Vim, Sublime, etc.)
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# 3. Temporary System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 4. Secrets and Local Environment Files
# ------------------------------------------------------------------------------
# Google Antigravity SDK requires the GEMINI_API_KEY. Keep credentials out of Git!
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ------------------------------------------------------------------------------
# 5. Python Bytecode, Compiles, and Caches
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ------------------------------------------------------------------------------
# 6. Packaging, Build, and Distribution
# ------------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ------------------------------------------------------------------------------
# 7. Testing, Coverage, and Linting
# ------------------------------------------------------------------------------
.htmlcov/
.tox/
.nosetests/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover

# ------------------------------------------------------------------------------
# 8. Antigravity 2.0 Local Overrides / Logs
# ------------------------------------------------------------------------------
# Ignore local run logs and runtime-generated artifacts
*.log
# If application data directory or scratch spaces are overridden locally:
# .antigravity/
# agy_data/

# ------------------------------------------------------------------------------
# 9. Local test assets and regression test files
# ------------------------------------------------------------------------------
tests/

